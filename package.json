{
  "name": "d2trade",
  "version": "0.0.1",
  "description": "D2Trade - Cloudflare Pages/Workers Application",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ./public --live-reload",
    "dev:worker": "wrangler dev",
    "build": "wrangler deploy --dry-run",

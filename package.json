    "deploy:pages": "wrangler pages deploy ./public",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250808.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.107.3"
  }
}
